# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Option A: Local Docker PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_db"

# Option B: Online Hosted PostgreSQL (Neon.tech - 100% Free)
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Option C: Online Hosted PostgreSQL (Supabase - 100% Free)
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Option D: Online Hosted PostgreSQL (Railway / Render)
# DATABASE_URL="postgresql://postgres:PASSWORD@hostname.render.com/attendance_db?sslmode=require"

# ============================================================
# SECURITY / JWT CONFIGURATION
# ============================================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================
# SERVER & CORS CONFIGURATION
# ============================================================
PORT=5000
HOST="0.0.0.0"
NODE_ENV="development"

# Frontend Origin(s) allowed by CORS:
# For local dev:
FRONTEND_URL="http://localhost:5173"
# For online hosting or multiple origins (comma-separated):
# FRONTEND_URL="http://localhost:5173,https://your-attendance-app.vercel.app"
